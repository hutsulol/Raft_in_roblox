-- Fishing.script (Pirate_2 -- Mercenary fishing animation controller)
--
-- Lives inside the mercenary model alongside Combat.script. When
-- MercenaryMovement.server.lua sets the IsFishing attribute to true
-- (i.e. the pirate has reached its fishing spot), this script loads the
-- child Animation named "Fishing" and plays it on the rig's Animator --
-- the same pattern Combat.script uses for its Attack animation.
--
-- The Animate script yields its idle/walk loop while IsFishing is true
-- so this animation isn't overridden.

local Self = script.Parent

-- Don't run inside the menu preview or ReplicatedStorage
while not Self:IsDescendantOf(workspace) do
	Self.AncestryChanged:Wait()
end

-- Only relevant for fishing-rod mercenaries
local equippedWeapon = Self:GetAttribute("EquippedWeapon") or "Sword"
if equippedWeapon ~= "FishingRod" then
	return
end

local humanoid = Self:FindFirstChildOfClass("Humanoid")
if not humanoid then
	warn("[Pirate_2/Fishing] no Humanoid")
	return
end

local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

-- Load the fishing animation from the child Animation instance placed
-- in Studio (same pattern as Combat's Attack animation).
local fishingAnim = script:FindFirstChild("Fishing")
if not fishingAnim or not fishingAnim:IsA("Animation") then
	warn("[Pirate_2/Fishing] no child Animation named 'Fishing' -- cannot play fishing pose")
	return
end

local fishingTrack = nil
local ok, track = pcall(function()
	return animator:LoadAnimation(fishingAnim)
end)
if ok and track then
	fishingTrack = track
	fishingTrack.Looped = true
	fishingTrack.Priority = Enum.AnimationPriority.Action
else
	warn("[Pirate_2/Fishing] failed to load fishing animation")
	return
end

-- React to the IsFishing attribute set by MercenaryMovement.server.lua.
-- Play the animation when the pirate reaches the fishing spot; stop it
-- when fishing is cancelled or the merc is reassigned.
local function onFishingChanged()
	local isFishing = Self:GetAttribute("IsFishing")
	if isFishing then
		fishingTrack:Play(0.3)
	else
		fishingTrack:Stop(0.3)
	end
end

Self:GetAttributeChangedSignal("IsFishing"):Connect(onFishingChanged)

-- Check initial state in case the attribute was set before this script ran
onFishingChanged()

-- Keep alive while the model exists
while Self.Parent and humanoid.Health > 0 do
	task.wait(1)
end

-- Clean up
if fishingTrack and fishingTrack.IsPlaying then
	fishingTrack:Stop(0)
end
