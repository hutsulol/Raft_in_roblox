local npc = script.Parent

-- Only relevant for fishing-rod mercenaries
local equippedWeapon = npc:GetAttribute("EquippedWeapon") or "Sword"
if equippedWeapon ~= "FishingRod" then
	return
end

local hum = npc:FindFirstChildOfClass("Humanoid")
local anim = hum:WaitForChild("Animator")

local idleAnim = anim:LoadAnimation(script:WaitForChild("Fishing"))
idleAnim.Looped = true

-- Wait for MercenaryMovement to set IsFishing = true (pirate reached
-- the fishing spot and the fake rod was swapped for the real one).
while npc.Parent and not npc:GetAttribute("IsFishing") do
	task.wait(0.5)
end

if npc.Parent and npc:GetAttribute("IsFishing") then
	idleAnim:Play()
end
