-- Combat.script (Pirate_2 — Mercenary AI)
--
-- This is a mercenary-flavored port of Enemy_Pirate/Zombie.script ("Basic
-- Monster" by ArceusInator). It lives inside the Pirate_2 model and
-- drives the rig with the same loop the hostile pirate uses:
--
--   SearchForTarget → TryRecomputePath → TravelPath → TryJumpCheck →
--   TryAttack
--
-- Differences from the hostile-pirate version:
--   * Self-contained: does NOT require Configurations / Mind / Respawn /
--     Died / Respawned / Attacked to exist in the model. The player
--     stripped those when they cleaned out Pirate_2. All config values
--     live in the ATTR table below.
--   * Role: MERCENARY. Protects players. Targets any Humanoid in
--     workspace that is NOT a player character and NOT another
--     mercenary. In practice this means HostilePirate and any future
--     hostile NPC (sharks, bosses, etc.) gets engaged automatically.
--   * No respawn. A killed mercenary stays dead.
--   * Attack animation: uses the equipped Tool's Activated event
--     (ClassicSword plays its own swing animation), so we don't depend
--     on script.Attack being present.

local CollectionService   = game:GetService("CollectionService")
local Players             = game:GetService("Players")
local PathfindingService  = game:GetService("PathfindingService")
local RunService          = game:GetService("RunService")

local Self = script.Parent

-- ── Tunables ──────────────────────────────────────────────────────────
-- Reference: hostile pirates (Enemy_Pirate) ship with MaxHealth ~100 and
-- roughly 8 damage per ~1s swing. Mercenaries are paid muscle, so they
-- outclass a hostile 1v1: more HP, faster swings, bigger hits, slightly
-- faster footwork so they can close the gap.
local ATTR = {
	MaximumDetectionDistance = 140,
	MaxHealth                = 250,  -- ~2.5× a hostile pirate
	WalkSpeed                = 18,   -- slightly faster than the default 16
	AttackDamage             = 18,   -- ~2× hostile damage
	AttackFrequency          = 1.8,  -- swings per second (~2× hostile)
	AttackRange              = 6,    -- studs
	RecomputePathFrequency   = 1,
	JumpCheckFrequency       = 1,
}

-- ── Wait for the rig to be in the world ───────────────────────────────
-- MercenariesMenu builds a ViewportFrame preview by cloning Pirate_2 and
-- stripping scripts, but belt and suspenders: don't run unless we're in
-- workspace (not the menu preview, not still inside ReplicatedStorage).
while not Self:IsDescendantOf(workspace) do
	Self.AncestryChanged:Wait()
end

-- ── Skip combat for non-weapon mercenaries ────────────────────────────
-- FishingRod mercs fish peacefully (handled by Fishing script).
-- Unarmed mercs harvest floating resources (handled by
-- HarvestResources script). Neither should engage hostile pirates.
local equippedWeapon = Self:GetAttribute("EquippedWeapon") or "Sword"
if equippedWeapon == "FishingRod" or equippedWeapon == "Unarmed" then
	return
end

local humanoid = Self:FindFirstChildOfClass("Humanoid")
local waited = 0
while humanoid == nil and waited < 5 do
	task.wait(0.1)
	waited = waited + 0.1
	humanoid = Self:FindFirstChildOfClass("Humanoid")
end
if humanoid == nil then
	warn("[Pirate_2/Combat] no Humanoid — AI cannot run")
	return
end

-- Load the Attack animation the user dropped inside this script. It's a
-- child Animation named "Attack", copied from the hostile pirate's
-- MonsterScript.Attack. Without this the sword swings (via tool:Activate)
-- but the rig itself never plays a slash animation.
local attackTrack = nil
local attackAnim = script:FindFirstChild("Attack")
if attackAnim and attackAnim:IsA("Animation") then
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local ok, track = pcall(function()
		return animator:LoadAnimation(attackAnim)
	end)
	if ok and track then
		attackTrack = track
	end
else
	warn("[Pirate_2/Combat] no child Animation named 'Attack' — swings will be animation-less")
end

-- Wake the rig up and buff its stats. MercenarySpawner already unanchors
-- and clears PlatformStand, but we also own the combat stats here so the
-- mercenary is definitively stronger than the hostile template it was
-- cloned from (which is stuck on whatever the base humanoid defaults to).
for _, d in Self:GetDescendants() do
	if d:IsA("BasePart") then d.Anchored = false end
end
humanoid.MaxHealth  = ATTR.MaxHealth
humanoid.Health     = ATTR.MaxHealth
humanoid.WalkSpeed  = ATTR.WalkSpeed
humanoid.PlatformStand = false
humanoid.Sit = false
pcall(function()
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, true)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
end)

-- ── Helpers ───────────────────────────────────────────────────────────

local function getTorso(model)
	-- R6 rigs have .Torso; R15 uses .UpperTorso. Pirate_2 is R6, but be
	-- defensive for target inspection.
	return model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("HumanoidRootPart")
end

local function getHRP()
	return Self:FindFirstChild("HumanoidRootPart")
end

local function isPlayerCharacter(model)
	return Players:GetPlayerFromCharacter(model) ~= nil
end

local function isFellowMercenary(model)
	return CollectionService:HasTag(model, "SpawnedMercenary")
end

-- ── State ─────────────────────────────────────────────────────────────
local currentTarget     = nil -- Humanoid
local pathCoords        = {}
local currentNode       = nil
local currentNodeIndex  = 1
local autoRecompute     = true
local recomputing       = false
local lastPathTime      = 0
local lastJumpCheck     = 0
local lastAttack        = 0

-- ── Target search ─────────────────────────────────────────────────────
-- Mercenary rule: attack anything with a Humanoid that is NOT a player
-- and NOT another mercenary. This covers HostilePirate today and any
-- future hostile NPCs automatically — no need to whitelist tags.
local function searchForTarget()
	local hrp = getHRP()
	if not hrp then return end
	local myPos = hrp.Position

	local closestHum, closestDist = nil, math.huge

	for _, model in workspace:GetDescendants() do
		if model:IsA("Humanoid")
			and model ~= humanoid
			and model.Health > 0
		then
			local parent = model.Parent
			if parent
				and not isPlayerCharacter(parent)
				and not isFellowMercenary(parent)
				and parent ~= Self
			then
				local torso = getTorso(parent)
				if torso and torso:IsA("BasePart") then
					local d = (torso.Position - myPos).Magnitude
					if d < ATTR.MaximumDetectionDistance and d < closestDist then
						closestHum, closestDist = model, d
					end
				end
			end
		end
	end

	currentTarget = closestHum
end

-- ── Target validity / CFrames ─────────────────────────────────────────

local function targetIsValid()
	if currentTarget == nil then return false end
	if currentTarget.Health <= 0 then return false end
	local torso = currentTarget.Parent and getTorso(currentTarget.Parent)
	return torso ~= nil and torso:IsA("BasePart")
end

local function getTargetPosition()
	if not targetIsValid() then return nil end
	return getTorso(currentTarget.Parent).Position
end

-- ── Pathfinding ───────────────────────────────────────────────────────

local function hasLineOfSight()
	local hrp = getHRP()
	local tp = getTargetPosition()
	if not hrp or not tp then return false end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { Self, currentTarget.Parent }

	local result = workspace:Raycast(hrp.Position, tp - hrp.Position, params)
	return result == nil
end

local function recomputePath()
	if recomputing then return end
	if not targetIsValid() then return end

	local hrp = getHRP()
	local tp = getTargetPosition()
	if not hrp or not tp then return end

	if hasLineOfSight() then
		autoRecompute   = true
		pathCoords      = { hrp.Position, tp }
		currentNode     = nil
		currentNodeIndex = 2
		lastPathTime    = tick()
		return
	end

	-- Fall back to real pathfinding around obstacles.
	recomputing = true
	autoRecompute = false

	local ok, path = pcall(function()
		return PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
		})
	end)
	if not ok or not path then
		recomputing = false
		return
	end

	local computeOk = pcall(function()
		path:ComputeAsync(hrp.Position, tp)
	end)
	if computeOk and path.Status == Enum.PathStatus.Success then
		pathCoords = {}
		for _, wp in path:GetWaypoints() do
			table.insert(pathCoords, wp.Position)
		end
		currentNode      = nil
		currentNodeIndex = 1
	else
		-- Pathfinding failed; fall back to direct approach.
		pathCoords = { hrp.Position, tp }
		currentNode      = nil
		currentNodeIndex = 2
	end

	recomputing = false
	lastPathTime = tick()
end

local function tryRecomputePath()
	if autoRecompute or tick() - lastPathTime > 1 / ATTR.RecomputePathFrequency then
		recomputePath()
	end
end

-- ── Jump check (rubber-band over small obstacles) ─────────────────────

local function jumpCheck()
	local hrp = getHRP()
	local tp = getTargetPosition()
	if not hrp or not tp then return end

	local checkVector = (tp - hrp.Position)
	if checkVector.Magnitude < 0.1 then return end
	checkVector = checkVector.Unit * 2

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { Self }

	local result = workspace:Raycast(
		hrp.Position + Vector3.new(0, -2.4, 0),
		checkVector,
		params
	)
	if result and currentTarget.Parent and not result.Instance:IsDescendantOf(currentTarget.Parent) then
		humanoid.Jump = true
	end
	lastJumpCheck = tick()
end

local function tryJumpCheck()
	if tick() - lastJumpCheck > 1 / ATTR.JumpCheckFrequency then
		jumpCheck()
	end
end

-- ── Attack ────────────────────────────────────────────────────────────

local function attack()
	local hrp = getHRP()
	local tp = getTargetPosition()
	if not hrp or not tp then return end

	if (hrp.Position - tp).Magnitude <= ATTR.AttackRange then
		currentTarget:TakeDamage(ATTR.AttackDamage)
		lastAttack = tick()

		-- Play the rig's own Attack animation (loaded from script.Attack)
		-- so the arm visibly swings, matching hostile pirates.
		if attackTrack then
			attackTrack:Play()
		end

		-- Also fire the tool's Activated event so the ClassicSword's
		-- internal swing sound / hitbox logic runs alongside.
		local tool = Self:FindFirstChildWhichIsA("Tool")
		if tool then
			pcall(function() tool:Activate() end)
		end
	end
end

local function tryAttack()
	if tick() - lastAttack > 1 / ATTR.AttackFrequency then
		attack()
	end
end

-- ── Path travel ───────────────────────────────────────────────────────

local function travelPath()
	if #pathCoords == 0 then return end

	local hrp = getHRP()
	if not hrp then return end
	local myPos = hrp.Position

	local skipCurrent = currentNode ~= nil and (currentNode - myPos).Magnitude < 3

	local closest, closestDist, closestIdx = nil, math.huge, nil
	for i = currentNodeIndex, #pathCoords do
		local c = pathCoords[i]
		if not (skipCurrent and c == currentNode) then
			local d = (c - myPos).Magnitude
			if d < closestDist then
				closest, closestDist, closestIdx = c, d, i
			else
				break
			end
		end
	end

	if closest then
		currentNode      = closest
		currentNodeIndex = closestIdx

		humanoid:MoveTo(closest)

		if humanoid.Health > 0 and targetIsValid() then
			tryJumpCheck()
			tryAttack()
		end

		if closestIdx == #pathCoords then
			autoRecompute = true
		end
	end
end

-- ── Main loop ─────────────────────────────────────────────────────────

while Self.Parent and humanoid.Health > 0 do
	searchForTarget()
	if targetIsValid() then
		tryRecomputePath()
		travelPath()
	end
	RunService.Heartbeat:Wait()
end
