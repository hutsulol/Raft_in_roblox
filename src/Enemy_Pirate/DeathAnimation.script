local pirate = script.Parent
local humanoid = pirate:WaitForChild("Humanoid")
local animateScript = pirate:WaitForChild("Animate")
local deathFolder = animateScript:WaitForChild("death")
local deathAnim = deathFolder:WaitForChild("DeathAnim")

local ragdoller = pirate:FindFirstChild("RagDoller")
	or pirate:FindFirstChild("Ragdoller")
if ragdoller and (ragdoller:IsA("Script") or ragdoller:IsA("LocalScript")) then
	ragdoller.Disabled = true
	ragdoller:Destroy()
end

humanoid.BreakJointsOnDeath = false

local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

local deathTrack = animator:LoadAnimation(deathAnim)
deathTrack.Priority = Enum.AnimationPriority.Action4
deathTrack.Looped = false

local function detachPart(part)
	if not part or not part:IsA("BasePart") then return end
	for _, d in part:GetChildren() do
		if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("Snap") then
			d:Destroy()
		end
	end
	for _, d in pirate:GetDescendants() do
		if (d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("Snap"))
			and (d.Part0 == part or d.Part1 == part) then
			d:Destroy()
		end
	end
	part.CanCollide = true
	part.Parent = workspace
	game.Debris:AddItem(part, 180)
end

local function dropAccessoryAndTools()
	local hat = pirate:FindFirstChild("PirateHat")
	if hat then
		detachPart(hat:FindFirstChild("Handle"))
		hat:Destroy()
	end

	for _, child in pirate:GetChildren() do
		if child:IsA("Tool") then
			local handle = child:FindFirstChild("Handle")
			detachPart(handle)
			child:Destroy()
		end
	end
end

humanoid.Died:Connect(function()
	if animateScript:IsA("BaseScript") then
		animateScript.Disabled = true
	end
	for _, track in animator:GetPlayingAnimationTracks() do
		track:Stop(0)
	end
	dropAccessoryAndTools()
	deathTrack:Play()
end)
