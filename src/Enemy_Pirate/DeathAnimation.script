local pirate = script.Parent
local humanoid = pirate:WaitForChild("Humanoid")
local animateScript = pirate:WaitForChild("Animate")
local deathFolder = animateScript:WaitForChild("death")
local deathAnim = deathFolder:WaitForChild("DeathAnim")

local ragdoller = pirate:FindFirstChild("RagDoller")
	or pirate:FindFirstChild("Ragdoller")
if ragdoller and (ragdoller:IsA("Script") or ragdoller:IsA("LocalScript")) then
	ragdoller.Disabled = true
	ragdoller:Destroy()
end

humanoid.BreakJointsOnDeath = false

local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

local deathTrack = animator:LoadAnimation(deathAnim)
deathTrack.Priority = Enum.AnimationPriority.Action4
deathTrack.Looped = false

local function detachPart(part, velocity, angular)
	if not part or not part:IsA("BasePart") then return end
	for _, d in part:GetChildren() do
		if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("Snap") then
			d:Destroy()
		end
	end
	for _, d in pirate:GetDescendants() do
		if (d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("Snap"))
			and (d.Part0 == part or d.Part1 == part) then
			d:Destroy()
		end
	end
	part.CanCollide = true
	part.Parent = workspace
	if velocity then
		part.AssemblyLinearVelocity = velocity
	end
	if angular then
		part.AssemblyAngularVelocity = angular
	end
	game.Debris:AddItem(part, 180)
end

local function dropAccessoryAndTools()
	local torso = pirate:FindFirstChild("Torso")
		or pirate:FindFirstChild("HumanoidRootPart")
	local right = torso and torso.CFrame.RightVector or Vector3.new(1, 0, 0)
	local up = Vector3.new(0, 1, 0)

	local hat = pirate:FindFirstChild("PirateHat")
	if hat then
		local handle = hat:FindFirstChild("Handle")
		local hatVel = up * 10 + right * ((math.random() - 0.5) * 8)
		detachPart(handle, hatVel, Vector3.new(
			(math.random() - 0.5) * 10,
			(math.random() - 0.5) * 10,
			(math.random() - 0.5) * 10
		))
		hat:Destroy()
	end

	for _, child in pirate:GetChildren() do
		if child:IsA("Tool") then
			local handle = child:FindFirstChild("Handle")
			local swordVel = right * 35 + up * 12
			detachPart(handle, swordVel, Vector3.new(
				(math.random() - 0.5) * 30,
				(math.random() - 0.5) * 30,
				(math.random() - 0.5) * 30
			))
			child:Destroy()
		end
	end
end

humanoid.Died:Connect(function()
	if animateScript:IsA("BaseScript") then
		animateScript.Disabled = true
	end
	for _, track in animator:GetPlayingAnimationTracks() do
		track:Stop(0)
	end
	dropAccessoryAndTools()
	deathTrack:Play()

	deathTrack.Stopped:Connect(function()
		deathTrack:Play()
		deathTrack.TimePosition = deathTrack.Length
		deathTrack:AdjustSpeed(0)

		local hrp = pirate:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.Anchored = true
		end
	end)
end)
