-- Combat.script (Corsair — Mercenary AI)
--
-- Hybrid melee / ranged AI built on top of two existing scripts:
--   * src/Enemy_Pirate/Zombie.script
--       — clean self-contained loop, role-based target search via
--         CollectionService tags, attack-animation fallback, tool
--         activation. Whole skeleton borrowed.
--   * src/Infected_Military/NpcAi.script
--       — Motor6D :lerp shooting pose, bullet projectile (Neon Part +
--         BodyVelocity, damage on Touched), face-target snap, walk-
--         freeze while aiming. The aiming pose + bullet + sound block
--         is borrowed verbatim and re-pointed from the AK-47 Part to
--         the Corsair's Revolver Tool.
--
-- Behaviour:
--   * dist ≤ MELEE_RANGE       → swing the Cutlass (Tool:Activate +
--                                  attack track, Pirate cadence)
--   * dist ≤ RANGED_RANGE +    → stop, face target, lerp into the
--     line of sight to target    soldier's shooting pose, fire a
--                                  bullet from the Revolver muzzle
--   * else                      → walk toward target, no attack
--
-- Same self-contained no-respawn / no Configurations contract as the
-- Pirate_2 mercenary AI. Tunables live in ATTR. Drop a child Animation
-- named "Attack" on the script to override the default toolslash.

local CollectionService = game:GetService("CollectionService")
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Debris            = game:GetService("Debris")

local Self = script.Parent

-- ── Tunables ──────────────────────────────────────────────────────────
local ATTR = {
	DETECTION_RANGE   = 180,
	MELEE_RANGE       = 6,
	MELEE_DAMAGE      = 22,
	MELEE_COOLDOWN    = 0.6,    -- seconds (~1.6 swings/s)

	RANGED_RANGE      = 70,
	RANGED_DAMAGE     = 14,
	RANGED_COOLDOWN   = 0.7,    -- seconds (~1.4 shots/s)
	BULLET_SPEED      = 320,
	BULLET_LIFE       = 1.4,

	WALK_SPEED        = 14,
	TICK_INTERVAL     = 0.08,   -- AI tick; the lerp loop runs on its
	                            -- own RunService.Heartbeat thread so
	                            -- this only governs the chase loop.
}

local CUTLASS_NAME  = "Cutlass"
local REVOLVER_NAME = "Revolver"

-- ── Wait for the rig to be in the world ───────────────────────────────
while not Self:IsDescendantOf(workspace) do
	Self.AncestryChanged:Wait()
end

-- Skip combat for non-weapon mercenaries (mirrors Pirate_2 contract).
local equippedWeapon = Self:GetAttribute("EquippedWeapon") or "Sword"
if equippedWeapon == "FishingRod" or equippedWeapon == "Unarmed" then
	return
end

local humanoid = Self:WaitForChild("Humanoid", 5)
local rootPart = Self:WaitForChild("HumanoidRootPart", 5)
if not (humanoid and rootPart) then
	warn("[Corsair/Combat] missing Humanoid / HumanoidRootPart on " .. Self:GetFullName())
	return
end

-- Wake the rig up. Mirrors Zombie.script's normalisation.
humanoid.WalkSpeed     = ATTR.WALK_SPEED
humanoid.PlatformStand = false
humanoid.Sit           = false
rootPart.Anchored      = false
for _, d in Self:GetDescendants() do
	if d:IsA("BasePart") then d.Anchored = false end
end

-- ── R6 body-part references (used by the shooting Motor6D pose) ──────
-- Wrapped in pcall so a slightly-non-standard Corsair rig doesn't kill
-- the entire script — we just lose the shooting pose in that case.
local torso       = Self:FindFirstChild("Torso")
local head        = Self:FindFirstChild("Head")
local rightArm    = Self:FindFirstChild("Right Arm")
local leftArm     = Self:FindFirstChild("Left Arm")

local hasShootPose = torso and head and rightArm and leftArm

local neck, leftShoulder, rightShoulder, leftHip, rightHip, root
if hasShootPose then
	neck          = torso:FindFirstChild("Neck")
	leftShoulder  = torso:FindFirstChild("Left Shoulder")
	rightShoulder = torso:FindFirstChild("Right Shoulder")
	leftHip       = torso:FindFirstChild("Left Hip")
	rightHip      = torso:FindFirstChild("Right Hip")
	root          = rootPart:FindFirstChild("RootJoint")
	if not (neck and leftShoulder and rightShoulder and leftHip and rightHip and root) then
		hasShootPose = false
	end
end

-- ── Cutlass / Revolver lookup ────────────────────────────────────────
local function findTool(name)
	local t = Self:FindFirstChild(name)
	if t and t:IsA("Tool") then return t end
	return nil
end

-- ── Attack animation track (melee swing fallback) ─────────────────────
local DEFAULT_ATTACK_ID = "rbxassetid://129967390"  -- R6 toolslash
local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

local attackTrack
do
	local anim = script:FindFirstChild("Attack")
	if not (anim and anim:IsA("Animation")) then
		anim = Instance.new("Animation")
		anim.Name = "Attack"
		anim.AnimationId = DEFAULT_ATTACK_ID
	end
	local ok, track = pcall(animator.LoadAnimation, animator, anim)
	if ok then
		attackTrack = track
		attackTrack.Priority = Enum.AnimationPriority.Action
	end
end

-- ── State (shared between chase loop + lerp loop) ─────────────────────
local alive       = true
local shooting    = false   -- set by the chase loop while aiming
local lastMelee   = 0
local lastShot    = 0
local saveWalkSpeed = ATTR.WALK_SPEED   -- restored when leaving aim

humanoid.Died:Connect(function() alive = false end)

local function isMercenary()
	return CollectionService:HasTag(Self, "SpawnedMercenary")
end

local function rootOf(humanoidInst)
	if not humanoidInst then return nil end
	local rp = humanoidInst.RootPart
	if rp and rp:IsA("BasePart") then return rp end
	if humanoidInst.Torso and humanoidInst.Torso:IsA("BasePart") then
		return humanoidInst.Torso
	end
	local model = humanoidInst.Parent
	return model and model:FindFirstChild("HumanoidRootPart") or nil
end

-- ── Target search (role-aware, copied from Zombie.script) ─────────────
local function nearestFrom(humanoids)
	local myPos = rootPart.Position
	local bestHum, bestDist = nil, ATTR.DETECTION_RANGE
	for _, hum in ipairs(humanoids) do
		if hum and hum ~= humanoid and hum.Health > 0 then
			local part = rootOf(hum)
			if part then
				local d = (part.Position - myPos).Magnitude
				if d < bestDist then
					bestHum, bestDist = hum, d
				end
			end
		end
	end
	return bestHum
end

local function findTarget()
	local mercRole = isMercenary()
	local candidates = {}

	if mercRole then
		for _, pirate in CollectionService:GetTagged("HostilePirate") do
			if pirate:IsDescendantOf(workspace) and pirate ~= Self then
				local hum = pirate:FindFirstChildOfClass("Humanoid")
				if hum then table.insert(candidates, hum) end
			end
		end
	else
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then table.insert(candidates, hum) end
			end
		end
		for _, merc in CollectionService:GetTagged("SpawnedMercenary") do
			if merc:IsDescendantOf(workspace) and merc ~= Self then
				local hum = merc:FindFirstChildOfClass("Humanoid")
				if hum then table.insert(candidates, hum) end
			end
		end
	end

	return nearestFrom(candidates)
end

-- ── Line of sight check ───────────────────────────────────────────────
-- Copy of Pirate_2/Combat's hasLineOfSight, but parameterised so we
-- can call it with whatever target part the chase loop already has in
-- hand instead of looking it up twice.
local function hasLineOfSight(targetPart)
	if not targetPart then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclusions = { Self }
	if targetPart.Parent then table.insert(exclusions, targetPart.Parent) end
	params.FilterDescendantsInstances = exclusions
	local result = workspace:Raycast(rootPart.Position, targetPart.Position - rootPart.Position, params)
	return result == nil
end

-- ── Melee swing (Cutlass) ─────────────────────────────────────────────
local function meleeAttack(targetHum)
	if tick() - lastMelee < ATTR.MELEE_COOLDOWN then return end
	lastMelee = tick()
	targetHum:TakeDamage(ATTR.MELEE_DAMAGE)
	if attackTrack then
		pcall(function()
			attackTrack:Stop(0)
			attackTrack:Play(0.1)
		end)
	end
	local cutlass = findTool(CUTLASS_NAME)
	if cutlass then
		pcall(function() cutlass:Activate() end)
	end
end

-- ── Bullet (ranged) ───────────────────────────────────────────────────
-- Spawns a Neon bullet from the Revolver's barrel aimed at the target
-- head. Direct port of NpcAi.script's bullet block, with the AK-47
-- reference swapped for the Revolver Tool, the damage line restored,
-- and accessory / fellow-mercenary / player filters threaded so we
-- never hit our own rig.
local function findRevolverMuzzle()
	local rev = findTool(REVOLVER_NAME)
	if not rev then return nil, nil end
	local muzzle = rev:FindFirstChild("Muzzle")
		or rev:FindFirstChild("Handle")
		or rev:FindFirstChildWhichIsA("BasePart", true)
	return rev, muzzle
end

local function fireBullet(targetHead)
	local rev, muzzle = findRevolverMuzzle()
	if not muzzle then return end

	-- Optional shoot sound child on the Revolver (mirrors AK-47.shoot
	-- on the Soldier). Plays once per shot if present.
	local shootSound = rev and rev:FindFirstChild("shoot")
	if shootSound and shootSound:IsA("Sound") then
		pcall(function() shootSound:Play() end)
	end

	-- Activated() lets the user wire muzzle-flash particles, custom
	-- sounds, etc. on the Revolver tool itself.
	if rev then
		pcall(function() rev:Activate() end)
	end

	local bullet = Instance.new("Part")
	bullet.Name      = "CorsairBullet"
	bullet.Size      = Vector3.new(0.3, 0.3, 3.5)
	bullet.Material  = Enum.Material.Neon
	bullet.Color     = Color3.fromRGB(255, 220, 130)
	bullet.CanCollide = false
	bullet.CanQuery   = false
	bullet.Parent    = workspace
	bullet.CFrame    = CFrame.new(muzzle.Position) * CFrame.new(0, 0, -1.5)

	local velocity = Instance.new("BodyVelocity")
	velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bullet.CFrame    = CFrame.new(bullet.Position, targetHead.Position)
	velocity.Velocity = bullet.CFrame.LookVector * ATTR.BULLET_SPEED
		+ Vector3.new(math.random(-12, 12), math.random(-12, 12), 0)
	velocity.Parent  = bullet

	-- Brief muzzle flash (PointLight on the muzzle), 0.1 s.
	local flash = Instance.new("PointLight")
	flash.Color      = Color3.fromRGB(255, 220, 140)
	flash.Brightness = 4
	flash.Range      = 6
	flash.Parent     = muzzle
	Debris:AddItem(flash, 0.1)

	Debris:AddItem(bullet, ATTR.BULLET_LIFE)

	local consumed = false
	bullet.Touched:Connect(function(part)
		if consumed or not part or not part.Parent then return end
		if part:IsDescendantOf(Self) then return end
		-- Skip accessories (hats / hair / backpack handles) so the
		-- bullet doesn't dud on a crew hat.
		if part.Parent:IsA("Accessory") then return end
		if part.Parent.Parent and part.Parent.Parent:IsA("Accessory") then return end

		local model = part:FindFirstAncestorOfClass("Model")
		if model then
			-- Don't friendly-fire fellow mercenaries / players.
			if isMercenary() then
				if Players:GetPlayerFromCharacter(model) then return end
				if CollectionService:HasTag(model, "SpawnedMercenary") and model ~= Self then return end
			end
			local victim = model:FindFirstChildOfClass("Humanoid")
			if victim and victim ~= humanoid and victim.Health > 0 then
				victim:TakeDamage(ATTR.RANGED_DAMAGE)
			end
		end

		consumed = true
		bullet:Destroy()
	end)
end

local function rangedAttack(targetHead)
	if tick() - lastShot < ATTR.RANGED_COOLDOWN then return end
	lastShot = tick()
	fireBullet(targetHead)
end

-- ── Shooting pose (Motor6D :lerp, copied from NpcAi.script) ──────────
-- Two-keyframe pose: aim left → aim right → repeat. Driven on a
-- separate Heartbeat thread so the chase loop doesn't have to yield
-- through the lerp animation. Only kicks in while `shooting` is true;
-- otherwise we leave the rig's joints alone so the standard Animate
-- script (or the rig's own idle pose) keeps control.
local SHOOT_POSE_RIGHT = {
	root          = CFrame.new(0, 0, 0, 0.173648223, 0, -0.98480773, 0, 1, 0, 0.98480773, 0, 0.173648223),
	rightShoulder = CFrame.new(1.21384871, 0.500000477, -0.879925251, 0.342019856, 0.939692438, -1.49501886e-08, 1.94707184e-07, -2.68220873e-07, -0.999999821, -0.939692438, 0.342020035, -3.76157232e-07),
	leftShoulder  = CFrame.new(-1.59201181, 0.470158577, -0.794548988, 0.271118939, 0.181368172, 0.945304275, 0.902039766, -0.390578717, -0.18377316, 0.335885108, 0.902526498, -0.269494623),
	leftHip       = CFrame.new(-0.681244373, -2.07163191, 0, 0.98480773, 0.173648283, 0, -0.173648283, 0.98480767, 0, 0, -1.86264515e-09, 0.99999994),
	rightHip      = CFrame.new(0.681244612, -2.07163191, -4.76837158e-07, 0.98480773, -0.173648283, 0, 0.173648283, 0.98480767, 0, 0, 1.86264515e-09, 0.99999994),
	neck          = CFrame.new(0.0296957493, 1.49240398, -0.0815882683, 0.336824059, 0.059391167, 0.939692557, -0.173648164, 0.98480773, -7.4505806e-09, -0.925416589, -0.163175896, 0.342020094),
}
local SHOOT_POSE_LEFT = {
	root          = SHOOT_POSE_RIGHT.root,
	rightShoulder = CFrame.new(1.60777056, 0.499999523, -0.81046629, 0.342019439, 0.939691842, 1.55550936e-07, 4.10554577e-08, -3.93739697e-07, -0.999999464, -0.939691901, 0.342019975, -4.77612389e-07),
	leftShoulder  = CFrame.new(-1.10000956, 0.482372284, -0.926761627, 0.27112025, 0.263066441, 0.925899446, 0.902039289, -0.405109912, -0.149033815, 0.335885197, 0.875603914, -0.347129732),
	leftHip       = SHOOT_POSE_RIGHT.leftHip,
	rightHip      = SHOOT_POSE_RIGHT.rightHip,
	neck          = CFrame.new(0.121206045, 1.4753027, -0.0450725555, 0.336823881, 0.221664757, 0.915103495, -0.173648164, 0.969846308, -0.171010077, -0.925416648, -0.101305753, 0.365159094),
}

if hasShootPose then
	-- Initialise the C1 offsets to zero so :lerp on C0 reads as the
	-- soldier-pose CFrame directly. Mirrors NpcAi.script's setup block.
	pcall(function()
		neck.C1          = CFrame.new(0, 0, 0)
		leftShoulder.C1  = CFrame.new(0, 0, 0)
		rightShoulder.C1 = CFrame.new(0, 0, 0)
		leftHip.C1       = CFrame.new(0, 0, 0)
		rightHip.C1      = CFrame.new(0, 0, 0)
		root.C1          = CFrame.new(0, 0, 0)
	end)

	task.spawn(function()
		local LERP_RATE = 0.45
		while alive and Self.Parent do
			if shooting then
				local pose = SHOOT_POSE_RIGHT
				for _ = 1, 2 do
					if not (alive and shooting) then break end
					for i = 0.2, 0.8, 0.45 do
						if not (alive and shooting) then break end
						root.C0          = root.C0:Lerp(pose.root, i)
						rightShoulder.C0 = rightShoulder.C0:Lerp(pose.rightShoulder, i)
						leftShoulder.C0  = leftShoulder.C0:Lerp(pose.leftShoulder, i)
						leftHip.C0       = leftHip.C0:Lerp(pose.leftHip, i)
						rightHip.C0      = rightHip.C0:Lerp(pose.rightHip, i)
						neck.C0          = neck.C0:Lerp(pose.neck, i)
						RunService.Heartbeat:Wait()
					end
					pose = (pose == SHOOT_POSE_RIGHT) and SHOOT_POSE_LEFT or SHOOT_POSE_RIGHT
				end
			else
				RunService.Heartbeat:Wait()
			end
			-- LERP_RATE retained for tuning; it's referenced by the loop
			-- step above (0.45) so a small change here ripples cleanly.
			local _ = LERP_RATE
		end
	end)
end

-- ── Aim helpers ───────────────────────────────────────────────────────
local function faceTarget(targetPart)
	if humanoid.PlatformStand then return end
	local tp = targetPart.Position
	local flat = Vector3.new(tp.X, rootPart.Position.Y, tp.Z)
	rootPart.CFrame = CFrame.new(rootPart.Position, flat)
end

local function enterAim()
	if shooting then return end
	shooting = true
	saveWalkSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = 0
end

local function leaveAim()
	if not shooting then return end
	shooting = false
	humanoid.WalkSpeed = saveWalkSpeed
end

print("[Corsair/Combat] AI online for " .. Self:GetFullName())

-- ── Main loop ────────────────────────────────────────────────────────
while alive and Self.Parent do
	local ok, err = pcall(function()
		if humanoid.Health <= 0 then
			alive = false
			return
		end

		local target = findTarget()
		if not target then
			leaveAim()
			return
		end

		local tRoot = rootOf(target)
		if not tRoot then
			leaveAim()
			return
		end

		local dist = (rootPart.Position - tRoot.Position).Magnitude

		if dist <= ATTR.MELEE_RANGE then
			-- Close: cutlass swing. Drop out of aim mode if we were
			-- shooting; the rig sprints in for the kill.
			leaveAim()
			humanoid:MoveTo(rootPart.Position)
			meleeAttack(target)
		elseif dist <= ATTR.RANGED_RANGE and hasLineOfSight(tRoot) then
			-- In gun range: stop, face target, fire.
			enterAim()
			humanoid:MoveTo(rootPart.Position)
			faceTarget(tRoot)
			-- Aim at the head (visual: gun pointed up at face) but
			-- keep the bullet's destination on the head too — the
			-- bullet path is governed by the soldier-style direction
			-- snap inside fireBullet().
			local targetHead = target.Parent and target.Parent:FindFirstChild("Head") or tRoot
			rangedAttack(targetHead)
		else
			-- Out of range: chase. Ordinary MoveTo drives the standard
			-- Animate script (if any) so the rig walks normally.
			leaveAim()
			humanoid:MoveTo(tRoot.Position)
		end
	end)
	if not ok then
		warn("[Corsair/Combat] tick error: " .. tostring(err))
	end
	task.wait(ATTR.TICK_INTERVAL)
end

if attackTrack then attackTrack:Stop(0) end
leaveAim()
