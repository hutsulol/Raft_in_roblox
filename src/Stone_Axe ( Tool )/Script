-- Stone_Axe Script
-- Lives inside the Stone_Axe Tool as a regular (server-side) Script,
-- mirroring the project's Machete tool. Plays the HitTree<RigType>
-- animation when the player swings the axe.
--
-- Server-side:
--   * Humanoid:LoadAnimation creates an AnimationTrack on the rig's
--     Animator. The Animator replicates the playback to every client
--     so the swing reads visually for everyone, not just the swinger.
--     LocalScripts inside Tools can race the auto-equip flow and miss
--     the first Equipped fire — that's why the user's other tools
--     (Machete, Sword) put this logic in a Script.
--   * Tool.Activated fires on the server when the player clicks; we
--     handle the cooldown + animation playback here and let the
--     companion StoneAxeClient.client.lua handle the chop game logic
--     (raycast → ChopTree RemoteEvent).

local Tool = script.Parent
Tool.Enabled = true

local Handle = Tool:WaitForChild("Handle")

local Services = {
	Players = game:GetService("Players"),
	Debris  = game:GetService("Debris"),
}

-- Optional swing sound. Some authored Stone_Axe tools ship a Swing
-- Sound under the Handle (mirrors the Sword); others don't. Look it
-- up softly so the script keeps working either way.
local function findSound(parent, names)
	for _, n in ipairs(names) do
		local s = parent:FindFirstChild(n, true)
		if s and s:IsA("Sound") then return s end
	end
	return nil
end
local SwingSound = findSound(Handle, { "Swing", "SwingSound", "Whoosh" })

local SWING_COOLDOWN = 0.8   -- per the user's brief; matches StoneAxeClient

local Animations = {}
local events = {}
local Player, Character, Humanoid

local function Activated()
	if not Tool.Enabled or not Humanoid or Humanoid.Health <= 0 then return end
	Tool.Enabled = false
	delay(SWING_COOLDOWN, function()
		Tool.Enabled = true
	end)

	local track = Animations.ChopAnim
	if track then
		pcall(function()
			track:Stop(0)
			track:Play(0.05)
		end)
	end
	if SwingSound then
		pcall(function() SwingSound:Play() end)
	end
end

-- Loads the chop animation once per equip. Tries the rig-specific
-- name first ("HitTreeR6" / "HitTreeR15"), falls back to "HitTreeR6"
-- (the user-authored Animation, asset id rbxassetid://82172717244396),
-- then to any Animation child so a future asset rename ships without
-- a code change.
local function loadChopAnim()
	if not Humanoid or not Tool then return nil end

	local anim = Tool:FindFirstChild("HitTree" .. Humanoid.RigType.Name)
		or Tool:FindFirstChild("HitTreeR6")
		or Tool:FindFirstChildWhichIsA("Animation", true)
	if not anim or not anim:IsA("Animation") then return nil end

	local ok, track = pcall(function() return Humanoid:LoadAnimation(anim) end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		return track
	end
	return nil
end

local function Equipped()
	Character = Tool.Parent
	Player    = Services.Players:GetPlayerFromCharacter(Character)
	Humanoid  = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health <= 0 then return end

	Animations.ChopAnim = loadChopAnim()

	events[#events + 1] = Tool.Activated:Connect(Activated)
end

local function Unequipped()
	for i = 1, #events do
		if events[i] then
			events[i]:Disconnect()
			events[i] = nil
		end
	end
	if Animations.ChopAnim then
		pcall(function() Animations.ChopAnim:Stop(0) end)
		Animations.ChopAnim = nil
	end
end

Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)
